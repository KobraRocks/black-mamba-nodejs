# Black Mamba (.env) Template
#
# Copy this file to `.env` and adjust values as needed.
# Only variables prefixed with `BM_` are read. Values in `.env` take precedence
# over shell environment for the running process.

# --- Core ---------------------------------------------------------------
# BM_DEV=false                  # Enable dev mode (non-secure cookies, verbose logs)
# BM_PORT=3000                  # HTTP port
# BM_MIGRATE=                   # "1"/"true" to run migrations at boot

# --- Database -----------------------------------------------------------
# BM_DATABASE=./app.sqlite      # Primary app database path
# BM_SESSION_DB=./sessions.db   # Session store database path

# --- Sessions / Security -----------------------------------------------
# BM_SESSION_SECRET=            # Required in production (>=16 chars). Used to sign cookies

# --- Magic Links --------------------------------------------------------
# BM_MAGIC_SECRET=              # If unset, falls back to BM_SESSION_SECRET

# --- WebAuthn -----------------------------------------------------------
# BM_RP_ID=localhost            # Relying Party ID (domain without port)
# BM_RP_NAME=Black Mamba        # Relying Party name (display)

# --- SMTP (optional) ----------------------------------------------------
# BM_SMTP_HOST=smtp.example.com # SMTP host
# BM_SMTP_PORT=465              # SMTP port (e.g., 465 for SMTPS)
# BM_SMTP_USERNAME=             # SMTP username
# BM_SMTP_PASSWORD=             # SMTP password
# BM_SMTP_USER=                 # Alternative username key accepted by SMTP lib
# BM_SMTP_PASS=                 # Alternative password key accepted by SMTP lib

# --- SQLite Benchmarks (optional) ---------------------------------------
# BM_BENCH_DURATION_MS=2000     # Benchmark duration in ms
# BM_BENCH_DB=./tmp/bench.db    # DB path for benchmark
# BM_BENCH_CONN=4               # Connections
# BM_BENCH_BATCH=100            # Batch size
# BM_BENCH_PAGE_SIZE=50         # Page size
# BM_BENCH_SEED_USERS=5000      # Seed users count
# BM_BENCH_SEED_LOGS=5000       # Seed logs count
# BM_BENCH_SESSION_POOL=1000    # Session pool size
# BM_BENCH_FORK=1               # Use multi-process fork
# BM_BENCH_SYNC=1               # Use sync API (1) vs async (0)

